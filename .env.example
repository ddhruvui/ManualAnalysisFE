# Copy to .env to override. .env is git-ignored; .env.example is committed.
# Build-time only — Vite inlines VITE_* into the bundle, so it is PUBLIC. URLs only, never keys.

# Where the backend API lives. Leave empty in dev: Vite proxies /api to the local backend.
# For a deployed frontend, set the backend's origin with no trailing slash and no /api suffix,
# e.g. https://manualanalysis-be.example.com — the backend must then allow this origin
# (ALLOWED_ORIGINS in backend/.env).
VITE_API_BASE=

# Dev only: where `npm run dev` proxies /api. Defaults to http://127.0.0.1:4000.
# VITE_PROXY_TARGET=http://127.0.0.1:4000
